{
  "listen": "0.0.0.0:8080",
  "node_profiles": {
    "sensor-a": { "interfaces": ["eno1.30"] },
    "sensor-b": { "interfaces": ["enp3s0.30"] }
  },
  "networks": [],
  "data_dir": "/data",
  "stale_after": "5m",
  "offline_after": "30m",
  "startup_grace": "30s",
  "retention_days": 30,
  "history_max_mb": 128,
  "max_devices": 4096,
  "active_arp": true,
  "scan_interval": "5m",
  "probe_rate": 2,
  "mdns_lookup": true,
  "reverse_dns": false,
  "hosts_url": "https://github.com/y2e-org/playbooks/blob/master/svc/coredns/config/tun.y2e.org.hosts",
  "hosts_refresh": "5m",
  "vendor_file": ""
}
